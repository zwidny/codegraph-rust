# Copy to .env and edit. Never commit the real .env.
SURREALDB_PASSWORD=change-me

# Image tag (pin it; do not track :latest in production).
SURREALDB_IMAGE_TAG=v3.3.0

# Storage backend: "surrealkv:/data" (default) or "rocksdb:/data".
# Switching backends requires an EMPTY volume and a full re-index.
SURREALDB_STORAGE=surrealkv:/data

# Host binding. Keep 127.0.0.1 unless remote clients need direct access.
SURREALDB_HOST=127.0.0.1
SURREALDB_PORT=8010

# Container memory cap. SurrealKV derives its block cache (~40%) and memtable
# (256MB) from this value. 8g keeps the cache near 3GB; raising it scales both.
SURREALDB_MEM_LIMIT=8g

# Reuse the existing volume created by the previous non-compose deployment.
SURREALDB_DATA_VOLUME=cg-server-data

SURREALDB_LOG=info

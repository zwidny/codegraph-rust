# Copy to .env and edit. Never commit the real .env.
SURREALDB_PASSWORD=change-me

# Image tag (pin it; do not track :latest in production).
SURREALDB_IMAGE_TAG=v4

# Storage backend. SurrealDB 4.x removed RocksDB, so this must stay "surrealkv:/data".
# Changing the backends or the major version needs an EMPTY volume and a full re-index.
SURREALDB_STORAGE=surrealkv:/data

# Host binding. Keep 127.0.0.1 unless remote clients need direct access.
SURREALDB_HOST=127.0.0.1
SURREALDB_PORT=8010

# Container memory cap. SurrealKV derives its block cache (~40%) and memtable
# (256MB) from this value. 8g keeps the cache near 3GB; raising it scales both.
SURREALDB_MEM_LIMIT=12g

# 4.x needs a fresh volume: a 3.x directory cannot be opened (see README.md).
SURREALDB_DATA_VOLUME=cg-server-data-v4

SURREALDB_LOG=info

# ---- Postgres backend (docker-compose.postgres.yml) ----

# Required. The compose file refuses to start without it.
CODEGRAPH_PG_PASSWORD=change-me

# Pin the image tag; do not track a moving :latest-like tag in production.
CODEGRAPH_PG_IMAGE_TAG=pg16

CODEGRAPH_PG_USER=codegraph
CODEGRAPH_PG_DB=codegraph

# Host binding and port. Point CODEGRAPH_PG_URL at this address.
CODEGRAPH_PG_HOST=127.0.0.1
CODEGRAPH_PG_PORT=5433

# Shared memory for a parallel HNSW build. Must be >= maintenance_work_mem
# (the indexer asks for 256MB); with less, CREATE INDEX fails and the indexer
# falls back to a ~3x slower build. Measured on 38k chunks: 64MB -> 11.7s,
# 512MB -> 4.7s.
CODEGRAPH_PG_SHM=512m

# Page cache. A 38k-chunk project's HNSW index is ~260MB; the 128MB default
# cannot hold it.
CODEGRAPH_PG_SHARED_BUFFERS=1GB

# Parallel workers used for index construction.
CODEGRAPH_PG_PARALLEL_BUILD=2

CODEGRAPH_PG_MEM_LIMIT=4g
